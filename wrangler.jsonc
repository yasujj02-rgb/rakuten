{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netprice-watch",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // workers.dev の公開 URL。Cloudflare Access を設定するまで本番デプロイしないこと（docs/deployment.md）
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "ENVIRONMENT": "production",
    "DATA_MODE": "auto",
    // access（推奨）| token。未設定・不正値の場合 API は全拒否（fail closed）
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "RAKUTEN_REFERER": "",
    "CACHE_TTL_SECONDS": "600",
    "SEARCH_LIMIT_PER_MINUTE": "20"
  }
  // 任意: Workers Rate Limiting（無料プランで利用可。詳細は docs/deployment.md）
  // "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }]
}
